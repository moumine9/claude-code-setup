{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(glab --version)",
      "Read(src/**)",
      "WebFetch(domain:usehooks-ts.com)"
    ],
    "soft_deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf:*)",
      "Write(.env*)",
      "Edit(.env*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ],
    "environment": [
      "This is a frontend development environment using React, TypeScript, and Yarn",
      "GitLab is used for version control — use glab CLI for MR operations",
      "Sensitive files (.env, credentials, keys) must never be read or committed"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/session-context.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/protect-sensitive-files.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/dry-run-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/auto-update-mr-on-commit.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/d/claude-code-setup/hooks/auto-sync.sh\""
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "glab-skills": {
      "source": {
        "source": "github",
        "repo": "moumine9/glab-skills"
      }
    },
    "claude-buddy-marketplace": {
      "source": {
        "source": "github",
        "repo": "rsts-dev/claude-buddy-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "buddy@claude-buddy-marketplace": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "statusLine": {
    "type": "command",
    "command": "<see README — generated by /claude-hud:setup>"
  },
  "model": "opus"
}
